{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeChat",
  "version": "0.1.2",
  "identifier": "com.ruanzeyu.claudechat",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "ClaudeChat", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 600 }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"], "windows": { "wix": { "language": ["zh-CN"] } } }
}
